{
  "name": "@hyperttp/transport-webrtc",
  "version": "0.4.0",
  "description": "WebRTC transport for Hyperttp powered by Werift",
  "keywords": [
    "bun",
    "fetch",
    "high-performance",
    "http",
    "hyperttp",
    "transport"
  ],
  "license": "MIT",
  "author": "dirold2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IT-IF-OR/hyperttp-transport-webrtc.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "import": "./dist/browser.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pcm-audio": {
      "types": "./dist/pcm-audio.d.ts",
      "import": "./dist/pcm-audio.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:shared": "tsc -p tsconfig.check.shared.json",
    "typecheck:node": "tsc -p tsconfig.check.node.json",
    "typecheck:bun": "tsc -p tsconfig.check.bun.json",
    "typecheck:deno": "tsc -p tsconfig.check.deno.json",
    "typecheck:runtimes": "bun run typecheck:shared && bun run typecheck:node && bun run typecheck:bun && bun run typecheck:deno",
    "lint": "oxlint src tests",
    "lint:fix": "oxlint src tests --fix",
    "format": "oxfmt src tests",
    "format:check": "oxfmt src tests --check",
    "test": "vitest run",
    "test:node": "RAGU_TEST_RUNTIME=node node node_modules/vitest/vitest.mjs run",
    "test:bun": "RAGU_TEST_RUNTIME=bun bun --bun node_modules/vitest/vitest.mjs run",
    "test:deno": "RAGU_TEST_RUNTIME=deno deno run --no-config --no-lock --node-modules-dir=manual --cached-only --no-prompt -A node_modules/vitest/vitest.mjs run",
    "dev": "tsx src/index.ts",
    "pub": "d-publish",
    "dist": "d-dist",
    "build": "tsc && esbuild \"dist/**/*.js\" --outdir=dist --allow-overwrite --minify --sourcemap && d-build",
    "clean": "node --input-type=module -e 'import { rmSync } from \"node:fs\"; rmSync(\"dist\", { recursive: true, force: true });'"
  },
  "dependencies": {
    "werift": "^0.26.0"
  },
  "devDependencies": {
    "@dirold2/dev-tools": "^1.1.3",
    "@types/bun": "^1.4.4",
    "@types/deno": "^2.7.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@hyperttp/types": "^0.5.4"
  }
}
